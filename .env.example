OPENROUTER_API_KEY="sk-or-v1-..."

# The model under test. Optional. Defaults to openrouter/anthropic/claude-sonnet-5.
# Format is openrouter/<slug>, and the slug must be in Flue's bundled model
# catalog (@earendil-works/pi-ai), which lags OpenRouter's live model list.
# EVAL_MODEL="openrouter/anthropic/claude-opus-4.8"

# The model that scores both arms. Optional. Defaults to
# openrouter/anthropic/claude-sonnet-5. Pinned separately on purpose: testing a
# different model must not also move the ruler.
# JUDGE_MODEL="openrouter/anthropic/claude-sonnet-5"

# Which agent the benchmark treats as the daddy-chill arm. Optional. Defaults to
# daddy-chill. Set it to score a candidate rule before it lands in SKILL.md.
# EVAL_AGENT="my-variant"
